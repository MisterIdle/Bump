code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Frequency;
uniform float Speed;
uniform float Amplitude;



void fragment() {
// Input:7
	vec2 n_out7p0 = UV;


// VectorDecompose:8
	float n_out8p0 = vec3(n_out7p0, 0.0).x;
	float n_out8p1 = vec3(n_out7p0, 0.0).y;
	float n_out8p2 = vec3(n_out7p0, 0.0).z;


// FloatParameter:3
	float n_out3p0 = Frequency;


// FloatOp:9
	float n_out9p0 = n_out8p1 * n_out3p0;


// Input:5
	float n_out5p0 = TIME;


// FloatParameter:2
	float n_out2p0 = Speed;


// FloatOp:6
	float n_out6p0 = n_out5p0 * n_out2p0;


// FloatOp:10
	float n_out10p0 = n_out9p0 + n_out6p0;


// FloatFunc:11
	float n_out11p0 = sin(n_out10p0);


// FloatParameter:4
	float n_out4p0 = Amplitude;


// FloatOp:12
	float n_out12p0 = n_out11p0 * n_out4p0;


// VectorCompose:13
	float n_in13p1 = 0.00000;
	vec2 n_out13p0 = vec2(n_out12p0, n_in13p1);


// VectorOp:14
	vec2 n_out14p0 = n_out7p0 + n_out13p0;


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(TEXTURE, n_out14p0);
	float n_out15p4 = n_out15p0.a;


// Output:0
	COLOR.a = n_out15p4;


}
"
