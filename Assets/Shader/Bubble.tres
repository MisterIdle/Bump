[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Frequency;
uniform float Speedy;
uniform float Amount = 0.10000000149012;
uniform float FresnelPower;



void vertex() {
// Input:5
	vec2 n_out5p0 = VERTEX;


// FloatParameter:8
	float n_out8p0 = Frequency;


// FloatOp:7
	float n_out7p0 = n_out5p0.x * n_out8p0;


// Input:9
	float n_out9p0 = TIME;


// FloatParameter:11
	float n_out11p0 = Speedy;


// FloatOp:10
	float n_out10p0 = n_out9p0 * n_out11p0;


// FloatOp:12
	float n_out12p0 = n_out7p0 + n_out10p0;


// FloatFunc:13
	float n_out13p0 = cos(n_out12p0);


// FloatParameter:15
	float n_out15p0 = Amount;


// FloatOp:14
	float n_out14p0 = n_out13p0 * n_out15p0;


// VectorOp:18
	vec3 n_out18p0 = vec3(n_out5p0, 0.0) + vec3(n_out14p0);


// Output:0
	VERTEX = vec2(n_out18p0.xy);


}

void fragment() {
// ColorConstant:13
	vec4 n_out13p0 = vec4(0.787538, 0.776956, 0.898110, 1.000000);


// FloatConstant:10
	float n_out10p0 = 0.500000;


// FloatConstant:11
	float n_out11p0 = 0.480000;


// Input:2
	vec2 n_out2p0 = UV;


// Vector2Constant:4
	vec2 n_out4p0 = vec2(0.500000, 0.500000);


// Distance:3
	float n_out3p0 = distance(n_out2p0, n_out4p0);


// SmoothStep:9
	float n_out9p0 = smoothstep(n_out10p0, n_out11p0, n_out3p0);


// FloatConstant:6
	float n_out6p0 = 2.000000;


// FloatOp:5
	float n_out5p0 = n_out3p0 * n_out6p0;


// FloatParameter:8
	float n_out8p0 = FresnelPower;


// FloatOp:7
	float n_out7p0 = pow(n_out5p0, n_out8p0);


// FloatOp:12
	float n_out12p0 = n_out9p0 * n_out7p0;


// Output:0
	COLOR.rgb = vec3(n_out13p0.xyz);
	COLOR.a = n_out12p0;


}
