code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 New : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Seuil : hint_range(0, 1) = 0.10000000149012;



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(TEXTURE, n_out4p0);


// ColorParameter:10
	vec4 n_out10p0 = New;


// ColorConstant:11
	vec4 n_out11p0 = vec4(0.698039, 0.698039, 0.698039, 1.000000);


// Distance:5
	float n_out5p0 = distance(vec3(n_out2p0.xyz), vec3(n_out11p0.xyz));


// FloatParameter:8
	float n_out8p0 = Seuil;


// Compare:7
	bool n_out7p0 = n_out5p0 < n_out8p0;


// Mix:9
	vec3 n_out9p0 = mix(vec3(n_out2p0.xyz), vec3(n_out10p0.xyz), vec3(n_out7p0 ? 1.0 : 0.0));


// Output:0
	COLOR.rgb = n_out9p0;


}
"
